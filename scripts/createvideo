#!/Users/neilhendren/.nvm/versions/node/v24.8.0/bin/node

import { execFile, spawn } from "child_process";

const rawArg = process.argv[2];
if (!rawArg) {
  console.error("Usage: createvideo <YouTube URL>");
  process.exit(1);
}
const youtubeUrl = String(rawArg);

// Run yt-dlp and stream logs live
const ytdlp = spawn("yt-dlp", [
  "--audio-quality=0",
  "-o",
  "./temp.%(ext)s",
  youtubeUrl,
]);

ytdlp.stdout.on("data", (data) => process.stdout.write(data));
ytdlp.stderr.on("data", (data) => process.stderr.write(data));

ytdlp.on("error", (err) => {
  console.error(`Failed to start yt-dlp: ${err.message}`);
});

ytdlp.on("close", (code) => {
  if (code !== 0) {
    console.error(`yt-dlp exited with code ${code}`);
    process.exit(code ?? 1);
  }

  // Find first downloaded temp.* file
  execFile(
    "/bin/sh",
    ["-c", "ls -1 temp.* | head -n 1"],
    (err, stdout, stderr) => {
      if (err) {
        console.error(`Error finding downloaded file: ${err.message}`);
        return;
      }
      if (stderr) {
        // ls writes errors to stderr (e.g., no matches). Treat as error if empty stdout
        if (!stdout.trim()) {
          console.error(`Error finding downloaded file stderr: ${stderr}`);
          return;
        }
      }

      const fileName = stdout.trim();
      if (!fileName) {
        console.error("No downloaded file found matching temp.*");
        return;
      }

      // Convert using ffmpeg, stream logs
      const ffmpeg = spawn("ffmpeg", [
        "-y",
        "-i",
        fileName,
        "-vcodec",
        "libx264",
        "-acodec",
        "aac",
        "output.mp4",
      ]);

      ffmpeg.stdout.on("data", (data) => process.stdout.write(data));
      ffmpeg.stderr.on("data", (data) => process.stderr.write(data));

      ffmpeg.on("error", (err) => {
        console.error(`Failed to start ffmpeg: ${err.message}`);
      });

      ffmpeg.on("close", (ffCode) => {
        if (ffCode !== 0) {
          console.error(`ffmpeg exited with code ${ffCode}`);
          process.exit(ffCode ?? 1);
        }

        const dest = `${process.env.HOME}/Downloads/output_${Date.now()}.mp4`;
        // Move output and then remove temps
        execFile(
          "/bin/sh",
          ["-c", `mv output.mp4 "${dest}"`],
          (mvErr, mvStdout, mvStderr) => {
            if (mvErr) {
              console.error(`Error moving output file: ${mvErr.message}`);
              return;
            }
            if (mvStderr) process.stderr.write(mvStderr);
            console.log(`Output file moved to ${dest}.`);

            execFile(
              "/bin/sh",
              ["-c", "rm -f temp.*"],
              (rmErr, rmStdout, rmStderr) => {
                if (rmErr) {
                  console.error(
                    `Error deleting temporary files: ${rmErr.message}`
                  );
                  return;
                }
                if (rmStderr) process.stderr.write(rmStderr);
                console.log("Temporary files deleted.");
              }
            );
          }
        );
      });
    }
  );
});
